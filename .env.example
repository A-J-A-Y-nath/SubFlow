# ===============================================
# SubFlow - Root Environment Configuration Example
# ===============================================

# Copy this file to backend/.env and frontend/.env respectively

# --- Backend Configuration ---
FLASK_ENV=development
PORT=5000
SECRET_KEY=replace_with_secure_random_key
JWT_SECRET_KEY=replace_with_jwt_secret_key
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/subflow?sslmode=require
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend Configuration ---
VITE_API_BASE_URL=http://localhost:5000/api/v1
