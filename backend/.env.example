# ==========================================
# SubFlow Backend Environment Configuration
# ==========================================

# Flask Environment
FLASK_ENV=development
FLASK_APP=app.py
PORT=5000
SECRET_KEY=change_this_to_a_random_secure_hex_key_in_production

# Database Configuration (Neon PostgreSQL)
# Example Neon connection string: postgresql://<user>:<password>@<neon_host>/<dbname>?sslmode=require
# If left empty, SubFlow defaults to a local SQLite database for quick local testing
DATABASE_URL=postgresql://user:password@ep-sample-pool-123456.us-east-2.aws.neon.tech/subflow?sslmode=require

# JWT Configuration
JWT_SECRET_KEY=change_this_to_another_secure_secret_for_jwt_tokens
JWT_ACCESS_HOURS=8
JWT_REFRESH_DAYS=30

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
